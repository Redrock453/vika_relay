# vika_relay — copy to .env and fill in. Providers without a key are skipped.

# === Telegram ===
TELEGRAM_BOT_TOKEN=your_bot_token_here
# Comma-separated Telegram user IDs allowed to use the bot
ALLOWED_IDS=123456789

# === LLM providers (fallback order: DeepSeek → OpenRouter → DO → Groq → Gemini → local) ===
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
DO_AI_API_KEY=
DO_AI_BASE_URL=
# Groq is also used for voice transcription (Whisper)
GROQ_API_KEY=
GEMINI_API_KEY=
# Local model on Ollama: last in the chain, no tools (uses OLLAMA_URL below). Empty = off.
# Example: VIKA_LOCAL_MODEL=qwen3:8b
VIKA_LOCAL_MODEL=

# Optional model overrides
# VIKA_DEEPSEEK_MODEL=deepseek-flash
# VIKA_MODEL=deepseek/deepseek-v4-pro
# VIKA_DO_MODEL=openai-gpt-oss-120b
# VIKA_GROQ_MODEL=openai/gpt-oss-120b
# VIKA_GEMINI_MODEL=gemini-2.5-flash
# VIKA_DEEPSEEK_PEAK_GUARD=1
# VIKA_LOCAL_TIMEOUT=300

# === Ollama: local model and RAG embeddings (optional) ===
OLLAMA_URL=http://127.0.0.1:11434
VIKA_EMBED_MODEL=bge-m3

# === Knowledge base (optional: without it the bot works with no RAG) ===
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
VIKA_RAG_COLLECTION=knowledge

# === Web search ===
SEARXNG_URL=http://127.0.0.1:8888
# Random string, required by SearXNG (e.g. `openssl rand -hex 32`)
SEARXNG_SECRET=

# === Storage and limits ===
HISTORY_FILE=./data/history.json
MAX_HISTORY=30
WEB_SEARCH_TIMEOUT=15
