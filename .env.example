# ---- Server ----
RELAY_HOST=0.0.0.0
RELAY_PORT=8080
RELAY_DATA_DIR=./data
RELAY_PROMPTS_DIR=prompts
# Comma-separated chat IDs with full access (tools, /model). Everyone else is a guest.
ALLOWED_IDS=

# ---- Providers (fallback order: deepseek -> openrouter -> claude -> do -> groq -> gemini) ----
DEEPSEEK_API_KEY=
VIKA_DEEPSEEK_BASE=https://api.deepseek.com
VIKA_DEEPSEEK_MODEL=deepseek-flash
VIKA_DEEPSEEK_MODEL_FLASH=deepseek-flash
VIKA_DEEPSEEK_MODEL_PRO=deepseek-v4-pro
VIKA_DEEPSEEK_EFFORT=high
VIKA_DEEPSEEK_PEAK_GUARD=1
VIKA_PEAK_HEAVY_CHARS=6000
OPENROUTER_API_KEY=
VIKA_MODEL=deepseek/deepseek-v4-pro
VIKA_MODEL_FLASH=deepseek/deepseek-v4-flash
VIKA_MODEL_PRO=deepseek/deepseek-v4-pro
VIKA_OR_PROVIDER_IGNORE=
ANTHROPIC_API_KEY=
DO_AI_API_KEY=
DO_AI_BASE_URL=
GROQ_API_KEY=
VIKA_GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
VIKA_GEMINI_MODEL=gemini-2.5-flash
VIKA_DEFAULT_MODEL=flash
VIKA_MAX_TOKENS=6000
VIKA_MAX_TOOL_ROUNDS=20
VIKA_GUEST_TOOL_ROUNDS=5
VIKA_PREFACE_MIN_CHARS=200

# ---- Local model (Ollama) ----
OLLAMA_URL=http://127.0.0.1:11434
VIKA_LOCAL_MODEL=hermes3:8b

# ---- RAG (Qdrant + Ollama embeddings) ----
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_URL=http://127.0.0.1:6333
VIKA_RAG_COLLECTION=knowledge
VIKA_EMBED_MODEL=bge-m3
VIKA_RAG_TOPK=3
VIKA_RAG_THRESHOLD=0.50
VIKA_RAG_SNIPPET=500

# ---- History / search ----
HISTORY_FILE=./data/history.json
MAX_HISTORY=30
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_ENGINES=google,duckduckgo,bing
SEARXNG_LANGUAGE=en-US
SEARXNG_SECRET=change-me
WEB_SEARCH_TIMEOUT=15
